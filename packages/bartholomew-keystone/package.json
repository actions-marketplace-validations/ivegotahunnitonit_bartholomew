{
  "name": "bartholomew-keystone",
  "displayName": "Bartholomew Keystone \u2014 AI Agent Capabilities & Passkeys (Cursor, Claude)",
  "description": "Cryptographically signed clearance tokens granting autonomous AI agents fine-grained access across files, commands, and domains in Cursor, Claude Desktop, and VS Code.",
  "version": "5.4.24",
  "publisher": "itsubsolomon",
  "icon": "icon.png",
  "license": "MIT",
  "categories": [
    "Other",
    "Linters",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "passkey",
    "security",
    "capabilities",
    "cursor",
    "copilot",
    "mcp",
    "claude",
    "cline",
    "windsurf",
    "permission-slip",
    "zero-trust",
    "open-vsx",
    "deepseek",
    "access-control"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "keystone.issuePasskey",
        "title": "Keystone: Issue Agent Capability Passkey",
        "icon": "$(key)"
      },
      {
        "command": "keystone.inspectClearance",
        "title": "Keystone: Inspect Active Agent Clearance",
        "icon": "$(shield)"
      },
      {
        "command": "keystone.revokePasskey",
        "title": "Keystone: Revoke Current Agent Passkey",
        "icon": "$(close)"
      },
      {
        "command": "keystone.validateAction",
        "title": "Keystone: Validate Agent Action against Passkey"
      },
      {
        "command": "keystone.auditReceipts",
        "title": "Keystone: View Clearance Audit Receipts"
      }
    ]
  },
  "scripts": {
    "compile": "node ../vscode-extension/node_modules/typescript/bin/tsc -p ./",
    "build": "node ../vscode-extension/node_modules/typescript/bin/tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bartholomew-ai/bartholomew.git"
  }
}