{
  "$schema": "https://modelcontextprotocol.io/schema.json",
  "name": "bartholomew-sentinel",
  "displayName": "Bartholomew Protocol Execution Sentinel",
  "description": "Sub-35µs AST execution firewall, zero-trust MCP proxy shield, and cryptographic proof verification for AI agents and swarms.",
  "version": "6.5.6",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivegotahunnitonit/bartholomew.git",
    "directory": "packages/mcp-proxy-guard"
  },
  "homepage": "https://bartholomew.info",
  "discovery": {
    "manifestUrl": "https://bartholomew.info/.well-known/mcp.json",
    "protocol": "BTP/6.5.6"
  },
  "transports": {
    "http": {
      "url": "https://bartolomew-cloud-engine-322603900775.us-central1.run.app/api/v1/m2m/verify",
      "method": "POST"
    },
    "stdio": {
      "command": "npx",
      "args": [
        "-y",
        "@bartholomew/vault",
        "mcp-shield"
      ]
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "verify_execution",
        "description": "Validates code, SQL, and bash operations against zero-trust AST security policies before execution",
        "parameters": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          },
          "required": [
            "tool_name"
          ]
        }
      },
      {
        "name": "btp_keystone_evaluate",
        "description": "Evaluates candidate agent tool action against active Keystone passkey clearance scopes (<35µs)",
        "parameters": {
          "type": "object",
          "properties": {
            "action_type": {
              "type": "string",
              "enum": ["COMMAND_EXEC", "FILE_WRITE", "FILE_READ", "FINANCIAL_SPEND", "NETWORK_QUERY"]
            },
            "target": {
              "type": "string"
            },
            "spend_usd": {
              "type": "number",
              "default": 0.0
            }
          },
          "required": [
            "action_type",
            "target"
          ]
        }
      }
    ]
  },
  "categories": [
    "security",
    "governance",
    "verification",
    "developer-tools"
  ]
}